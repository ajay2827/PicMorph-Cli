  "dependencies": {
    "axios": "^1.7.2",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dotenv": "^16.4.5",
    "exif-reader": "^2.0.3",
    "fast-glob": "^3.3.3",
